generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}

model Profile {
  id          String   @id @default(cuid())
  name        String
  greeting    String
  tagline     String
  aboutText   String
  cvUrl       String?
  instagram   String?
  github      String?
  linkedin    String?
  whatsapp    String?
  photoUrl    String?
  galleryUrls String[]
  updatedAt   DateTime @updatedAt
}

model Experience {
  id        String   @id @default(cuid())
  title     String
  company   String
  dateLabel String
  bullets   String[]
  colorTag  String   @default("pink")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Education {
  id          String   @id @default(cuid())
  title       String
  institution String
  dateLabel   String
  summary     String?
  bullets     String[]
  order       Int      @default(0)
}

model Organization {
  id        String   @id @default(cuid())
  title     String
  role      String
  dateLabel String
  bullets   String[]
  imageUrl  String?
  colorTag  String   @default("pink")
  order     Int      @default(0)
}

model Volunteer {
  id        String   @id @default(cuid())
  title     String
  company   String
  dateLabel String
  bullets   String[]
  colorTag  String   @default("green")
  order     Int      @default(0)
}

enum ProjectCategory {
  DEVELOPMENT
  UIUX
  DESIGN
  OTHERS
}

model Project {
  id             String          @id @default(cuid())
  title          String
  description    String?
  imageUrl       String?
  link           String?
  linkLabel      String?
  secondaryLink  String?
  secondaryLabel String?
  category       ProjectCategory
  subcategory    String?
  order          Int             @default(0)
  createdAt      DateTime        @default(now())
}

model Certification {
  id       String @id @default(cuid())
  title    String
  imageUrl String?
  colorTag String  @default("pink")
  order    Int     @default(0)
}

enum SkillCategory {
  FRONTEND
  BACKEND
  DESIGN
  TOOLS
  SOFT_SKILLS
  LANGUAGES
}

model Skill {
  id       String        @id @default(cuid())
  name     String
  category SkillCategory
  order    Int           @default(0)
}